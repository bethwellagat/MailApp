<?xml version="1.0" encoding="UTF-8"?>
<!-- Deny all web access — this directory holds private user data (signatures,
     workspace logos, filters, contacts, outbox, update token). IIS equivalent of
     the .htaccess beside it. lib/util.php re-creates this file if it goes
     missing, since the updater never writes into data/. -->
<configuration>
  <system.webServer>
    <authorization>
      <deny users="*" />
    </authorization>
  </system.webServer>
</configuration>
